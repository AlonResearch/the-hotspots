{
  "name": "the-hotspots-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "import-forecast": "tsx scripts/import-forecast.ts",
    "build-deploy": "npm run typecheck && tsx scripts/build-deploy.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@luma.gl/core": "9.4.2",
    "@mapbox/polyline": "1.2.1",
    "d3-array": "3.2.5",
    "d3-scale": "4.0.3",
    "h3-js": "4.5.0",
    "maplibre-gl": "5.24.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "terra-draw": "1.39.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/mapbox__polyline": "1.0.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
